#usda 1.0
(
    defaultPrim = "World"
    doc = "restroom_map_straight290.usda 에서 Floor2_Pipes 만 분리한 사본 (tools/split_map.py). 좌표·정점은 원본과 동일하다."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Concrete"
        {
            token outputs:surface.connect = </World/Looks/Concrete/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.73, 0.7)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "Pipe"
        {
            token outputs:surface.connect = </World/Looks/Pipe/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.4, 0.45)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

